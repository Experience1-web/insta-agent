# --- Claude API (das "Gehirn" des Agenten) -------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Instagram Graph API (offizieller Weg, ToS-konform) ------------------
# Voraussetzung: Instagram Business- oder Creator-Account, verknüpft mit
# einer Facebook-Seite, plus eine Meta-App mit den Rechten
# instagram_basic, instagram_content_publish, instagram_manage_insights.
IG_USER_ID=
IG_ACCESS_TOKEN=
# Langlebiger Token läuft nach ~60 Tagen ab -> `insta-agent token-refresh`
META_APP_ID=
META_APP_SECRET=

# --- Bild-Hosting --------------------------------------------------------
# Die Graph API lädt Bilder NICHT hoch, sie zieht sie von einer öffentlichen
# URL. Hier die Basis-URL des Ortes eintragen, wohin `PUBLIC_MEDIA_DIR`
# synchronisiert wird (S3, Netlify, eigener Webspace ...).
PUBLIC_MEDIA_BASE_URL=
PUBLIC_MEDIA_DIR=./out/media

# --- Ökonomie -----------------------------------------------------------
# Startkapital in USD, das der Agent verbrauchen darf, bevor er sich selbst
# anhält. Er darf NICHT eigenständig nachkaufen - er meldet sich bei dir.
TREASURY_START_USD=20.00
